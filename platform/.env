# CCPIP configuration. Copy to .env and edit as needed.
# All settings use the CCPIP_ prefix (avoids collisions with k8s Service vars).

# --- Web UI ---
WEB_PORT=8080

# --- Ingestion API ---
INGESTION_PORT=8000

# --- Database (used by docker compose) ---
POSTGRES_USER=ccpip
POSTGRES_PASSWORD=ccpip
POSTGRES_DB=ccpip
DB_PORT=5432

# --- Synthetic data ---
CCPIP_RANDOM_SEED=42
CCPIP_DELAY_THRESHOLD_DAYS=5.0
